{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/PerryLink/dsh-research-bench/main/data/meta/schema.json",
  "title": "Synthetic meta-analysis pooling benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "description",
    "tags",
    "studies",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^meta-[0-9]{4}$"
    },
    "category": {
      "enum": [
        "homogeneous",
        "medium-heterogeneity",
        "high-heterogeneity",
        "zero-effect",
        "negative-effect",
        "small-k"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 22,
      "uniqueItems": true,
      "items": {
        "enum": [
          "k2",
          "k5",
          "k10",
          "k12",
          "equal-se",
          "unequal-se",
          "se-input",
          "ci-input",
          "mixed-input",
          "egger-run",
          "egger-boundary",
          "egger-not-run",
          "wide-narrow-weights",
          "small-k",
          "positive-effect",
          "negative-effect",
          "zero-effect",
          "sign-flip",
          "symmetric-effects",
          "q-zero",
          "i2-zero",
          "tau2-zero"
        ]
      }
    },
    "studies": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/study"
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "df",
        "fixed",
        "random",
        "Q",
        "pQ",
        "I2",
        "tau2",
        "egger"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "df": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "fixed": {
          "$ref": "#/$defs/estimate"
        },
        "random": {
          "$ref": "#/$defs/estimate"
        },
        "Q": {
          "type": "number",
          "minimum": 0
        },
        "pQ": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "I2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tau2": {
          "type": "number",
          "minimum": 0
        },
        "egger": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "effect"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "number"
        },
        "se": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ciLow": {
          "type": "number"
        },
        "ciHigh": {
          "type": "number"
        }
      },
      "oneOf": [
        {
          "required": [
            "se"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ciLow"
                ]
              },
              {
                "required": [
                  "ciHigh"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "ciLow",
            "ciHigh"
          ],
          "not": {
            "required": [
              "se"
            ]
          }
        }
      ]
    },
    "estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "se",
        "ciLow",
        "ciHigh"
      ],
      "properties": {
        "effect": {
          "type": "number"
        },
        "se": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ciLow": {
          "type": "number"
        },
        "ciHigh": {
          "type": "number"
        }
      }
    }
  }
}
